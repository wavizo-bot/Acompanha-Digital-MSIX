<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="wavizo.AcompanhaDigital"
            Publisher="CN=57BB464E-553F-45B6-A4ED-B253157408EB"
            Version="1.0.11.0"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Acompanha Digital</DisplayName>
    <PublisherDisplayName>wavizo</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
    <Description>Organizador offline para Agentes Comunitários de Saúde. Cadastro de moradores, visitas domiciliares, guias, agendamentos e calendário — tudo offline, sem anúncios e sem cadastro.</Description>
  </Properties>
  <Resources>
    <Resource Language="pt-BR" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
  <Applications>
    <Application Id="App" Executable="AcompanhaDigital.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Acompanha Digital"
                          Description="Organizador offline para Agentes Comunitários de Saúde"
                          BackgroundColor="#0066b3"
                          Square150x150Logo="assets\Square150x150Logo.png"
                          Square44x44Logo="assets\Square44x44Logo.png">
        <uap:DefaultTile ShortName="Acompanha Digital"
                         Wide310x150Logo="assets\Wide310x150Logo.png"
                         Square310x310Logo="assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="assets\SplashScreen.png" BackgroundColor="#0066b3" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
